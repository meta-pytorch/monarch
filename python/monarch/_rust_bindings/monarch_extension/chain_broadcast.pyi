# pyre-unsafe

class ChainCtx: ...

class ChainServer:
    @property
    def addr(self) -> str: ...

class ChainSession: ...

def new_ctx(block_size: int) -> ChainCtx: ...
def serve(bind_addr: str | None = None) -> ChainServer: ...
def connect(addr: str, num_streams: int = ...) -> ChainSession: ...
def send_block(
    session: ChainSession, data: bytes, chunk_size: int, tag: int
) -> int: ...
def forward(
    server: ChainServer,
    successor: str | None,
    ctx: ChainCtx,
    num_streams: int = ...,
) -> None: ...
def ctx_wait_into(
    ctx: ChainCtx, dst_addr: int, dst_len: int, want: int, timeout_ms: int
) -> None: ...
def ctx_close(ctx: ChainCtx) -> None: ...
